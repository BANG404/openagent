RUNNER_NAME=oa-sdk-linux-01
RUNNER_REPOSITORY=https://github.com/BANG404/openagent-sdk
RUNNER_LABELS=openagent-sdk,linux-x64-cache
FRPC_BIN=/absolute/path/to/frpc
MINIO_ROOT_USER=replace-with-random-access-key
MINIO_ROOT_PASSWORD=replace-with-random-secret-key
SCCACHE_BUCKET=openagent-sccache
SCCACHE_ACCESS_KEY=replace-with-scoped-access-key
SCCACHE_SECRET_KEY=replace-with-scoped-secret-key
