{
  "format_version": 1,
  "target": "frontend",
  "target_version": 1,
  "id": "delayed-terminal",
  "completeness": "full",
  "allowed_pending": [],
  "initial": {
    "active_conversation": "A",
    "conversations": [
      {
        "id": "A",
        "title": "Synthetic A",
        "messages": [
          {
            "id": "user-A",
            "role": "user",
            "content": "first",
            "timestamp": 1
          }
        ],
        "createdAt": 1,
        "updatedAt": 1
      },
      {
        "id": "B",
        "title": "Synthetic sibling",
        "messages": [
          {
            "id": "user-B",
            "role": "user",
            "content": "sibling",
            "timestamp": 1
          }
        ],
        "createdAt": 1,
        "updatedAt": 1
      }
    ],
    "streams": [
      {
        "conversation": "A",
        "assistant": "assistant-A"
      },
      {
        "conversation": "B",
        "assistant": "assistant-B"
      }
    ]
  },
  "records": [
    {
      "record_id": "r1",
      "producer": "host",
      "epoch": 0,
      "seq": 1,
      "kind": "action",
      "correlation": "A",
      "caused_by": [],
      "monotonic_offset_us": 1,
      "payload": {
        "action": "start-stream",
        "conversation": "A",
        "assistant": "assistant-next"
      }
    },
    {
      "record_id": "r2",
      "producer": "host",
      "epoch": 0,
      "seq": 2,
      "kind": "event.deliver",
      "correlation": "A",
      "caused_by": [],
      "monotonic_offset_us": 2,
      "payload": {
        "event": "chat.chunk",
        "data": {
          "conv_id": "A",
          "text": "next"
        }
      }
    },
    {
      "record_id": "r3",
      "producer": "host",
      "epoch": 0,
      "seq": 3,
      "kind": "event.deliver",
      "correlation": "A",
      "caused_by": [],
      "monotonic_offset_us": 3,
      "payload": {
        "event": "chat.cancelled",
        "data": {
          "conv_id": "A",
          "asst_msg_id": "assistant-A",
          "turn_id": "assistant-A"
        }
      }
    },
    {
      "record_id": "r4",
      "producer": "host",
      "epoch": 0,
      "seq": 4,
      "kind": "event.deliver",
      "correlation": "A",
      "caused_by": [],
      "monotonic_offset_us": 4,
      "payload": {
        "event": "chat.done",
        "data": {
          "conv_id": "A",
          "asst_msg_id": "assistant-next",
          "turn_id": "assistant-next",
          "error": null
        }
      }
    }
  ],
  "schedule": [
    {
      "step": "s1",
      "do": "action",
      "after": [],
      "record": "r1"
    },
    {
      "step": "s2",
      "do": "deliver",
      "after": ["s1"],
      "record": "r2"
    },
    {
      "step": "s3",
      "do": "deliver",
      "after": ["s2"],
      "record": "r3"
    },
    {
      "step": "s4",
      "do": "assert",
      "after": ["s3"],
      "assertion": "new-stream-survives"
    },
    {
      "step": "s5",
      "do": "assert",
      "after": ["s4"],
      "assertion": "no-old-terminal"
    },
    {
      "step": "s6",
      "do": "deliver",
      "after": ["s5"],
      "record": "r4"
    },
    {
      "step": "s7",
      "do": "assert",
      "after": ["s6"],
      "assertion": "next-turn-completes"
    },
    {
      "step": "s8",
      "do": "assert",
      "after": ["s7"],
      "assertion": "sibling-isolated"
    }
  ],
  "assertions": [
    {
      "id": "new-stream-survives",
      "path": ["assistant_ids", "A"],
      "equals": "assistant-next"
    },
    {
      "id": "no-old-terminal",
      "path": ["conversations", "A", "message_ids"],
      "equals": ["user-A"]
    },
    {
      "id": "next-turn-completes",
      "path": ["conversations", "A", "message_ids"],
      "equals": ["user-A", "assistant-next"]
    },
    {
      "id": "sibling-isolated",
      "path": ["conversations", "B", "message_ids"],
      "equals": ["user-B"]
    }
  ]
}
