{
  "name": "openagent",
  "version": "0.24.2-beta.1",
  "description": "",
  "type": "module",
  "packageManager": "bun@1.2.21",
  "scripts": {
    "prepare": "bun scripts/install-git-hooks.mjs",
    "dev": "vite dev",
    "build": "vite build",
    "build:pages": "bun scripts/build-pages.mjs",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "bun test",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:agent-runtime": "cargo test --manifest-path sdk/rust/openagent-runtime/Cargo.toml",
    "dev:agent-server": "cargo run --manifest-path src-tauri/Cargo.toml --bin openagent-agent-server",
    "dev:agent-input-api": "cargo run --manifest-path sdk/rust/openagent-runtime/Cargo.toml --features test-api --bin openagent-runtime-test-api -- --port 0",
    "format:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint:actions": "github-actionlint",
    "tauri": "tauri",
    "commit:lint": "bun scripts/validate-commit-msg.mjs",
    "release": "bun scripts/release.mjs",
    "release:beta:dry-run": "bun scripts/release.mjs --dry-run --channel=beta",
    "release:stable:dry-run": "bun scripts/release.mjs --dry-run --channel=stable",
    "release:prepare:beta": "bun scripts/release.mjs --channel=beta",
    "release:prepare:stable": "bun scripts/release.mjs --channel=stable",
    "changelog": "git-cliff -o CHANGELOG.md",
    "changelog:unreleased": "git-cliff --unreleased"
  },
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@mdxeditor/editor": "^4.0.4",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "bits-ui": "^2.18.1",
    "echarts": "^6.0.0",
    "html-to-image": "^1.11.13",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "svelte-streamdown": "^3.0.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.9.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "github-actionlint": "^1.7.12",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
