{
  "name": "openagent",
  "version": "0.70.2-beta.1",
  "description": "OpenAgent desktop AI agent client",
  "homepage": "https://github.com/BANG404/openagent",
  "repository": {
    "type": "git",
    "url": "https://github.com/BANG404/openagent.git"
  },
  "type": "module",
  "packageManager": "bun@1.2.21",
  "scripts": {
    "prepare": "bun scripts/install-git-hooks.mjs",
    "dev": "vite dev",
    "dev:tauri": "bun scripts/dev-with-runtime-server.mjs",
    "build": "vite build",
    "check:bundle-size": "bun scripts/check-bundle-size.mjs",
    "check:embedding-model": "bun scripts/fetch-embedding-model.mjs --check",
    "check:docs": "bun scripts/check-docs-sync.mjs",
    "preflight": "bun scripts/preflight.mjs",
    "fetch:embedding-model": "bun scripts/fetch-embedding-model.mjs",
    "prepare:worktree:dev": "bun scripts/prepare-worktree.mjs --profile dev",
    "prepare:worktree:release": "bun scripts/prepare-worktree.mjs --profile release",
    "prepare:linux-sandbox:dev": "bun scripts/prepare-linux-sandbox-helper.mjs --profile dev",
    "prepare:linux-sandbox:release": "bun scripts/prepare-linux-sandbox-helper.mjs --profile release",
    "prepare:runtime-server:dev": "bun scripts/prepare-runtime-server.mjs --profile dev",
    "prepare:runtime-server:release": "bun scripts/prepare-runtime-server.mjs --profile release",
    "prepare:cua-driver": "bun scripts/prepare-cua-driver.mjs",
    "prepare:windows-sandbox:dev": "bun scripts/prepare-windows-sandbox-helpers.mjs --profile dev",
    "prepare:windows-sandbox:release": "bun scripts/prepare-windows-sandbox-helpers.mjs --profile release",
    "build:pages": "bun scripts/build-pages.mjs",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:tests": "svelte-kit sync && tsc --noEmit --project tsconfig.tests.json",
    "lint:frontend": "eslint src tests scripts *.js --max-warnings=0",
    "format": "prettier --write src tests scripts .github *.json *.js",
    "format:check": "prettier --check src tests scripts .github *.json *.js",
    "test": "bun test",
    "test:blackbox:automation": "bun scripts/test-automation-blackbox.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:agent-runtime": "cargo test --manifest-path sdk/rust/openagent-runtime/Cargo.toml",
    "test:harness-integration": "bun scripts/test-harness-integration.mjs",
    "check:harness-openapi": "bun run --cwd sdk/harness-typescript check:openapi",
    "dev:agent-server": "cargo run --manifest-path src-tauri/Cargo.toml --features embedded-runtime --bin openagent-agent-server",
    "dev:agent-input-api": "cargo run --manifest-path sdk/rust/openagent-runtime/Cargo.toml --features test-api --bin openagent-runtime-test-api -- --port 0",
    "format:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint:actions": "github-actionlint",
    "tauri": "bun scripts/tauri.mjs",
    "tauri:dev:embedded": "bun scripts/tauri.mjs dev --embedded-runtime",
    "tauri:build": "bun scripts/tauri-build.mjs",
    "tauri:bundle": "bun scripts/tauri-bundle.mjs",
    "tauri:build:full": "bun scripts/tauri-build.mjs --config src-tauri/tauri.full.conf.json",
    "commit:lint": "bun scripts/validate-commit-msg.mjs",
    "release": "bun scripts/release.mjs",
    "release:beta:dry-run": "bun scripts/release.mjs --dry-run --channel=beta",
    "release:rc:dry-run": "bun scripts/release.mjs --dry-run --channel=rc",
    "release:stable:dry-run": "bun scripts/release.mjs --dry-run --channel=stable",
    "release:prepare:beta": "bun scripts/release.mjs --channel=beta",
    "release:prepare:rc": "bun scripts/release.mjs --channel=rc",
    "release:prepare:stable": "bun scripts/release.mjs --channel=stable",
    "changelog": "git-cliff -o CHANGELOG.md",
    "changelog:unreleased": "git-cliff --unreleased"
  },
  "license": "GPL-3.0-or-later",
  "overrides": {
    "adm-zip": "0.6.1",
    "cookie": "0.7.2",
    "devalue": "5.9.4",
    "dompurify": "3.4.15",
    "mermaid": "11.16.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.28",
    "tar": "7.5.22"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-updater": "^2.12.0",
    "bits-ui": "^2.19.2",
    "echarts": "^6.1.0",
    "fzstd": "^0.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "svelte-streamdown": "^3.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.5",
    "@types/bun": "1.3.14",
    "@types/node": "^25.9.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "eslint-plugin-svelte": "^3.23.0",
    "github-actionlint": "^1.7.12",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.4.3"
  }
}
