{
  "name": "@bang404/openagent-sdk",
  "version": "0.3.0",
  "description": "Typed OpenAgent client and optional local Runtime management",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BANG404/openagent.git",
    "directory": "sdk/typescript"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./httpTransport": {
      "types": "./dist/httpTransport.d.ts",
      "import": "./dist/httpTransport.js"
    },
    "./tauriClient": {
      "types": "./dist/tauriClient.d.ts",
      "import": "./dist/tauriClient.js"
    },
    "./tauriTransport": {
      "types": "./dist/tauriTransport.d.ts",
      "import": "./dist/tauriTransport.js"
    },
    "./transport": {
      "types": "./dist/transport.d.ts",
      "import": "./dist/transport.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "bun test",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "~5.6.2",
    "@tauri-apps/api": "^2"
  },
  "peerDependencies": {
    "@tauri-apps/api": "^2"
  },
  "peerDependenciesMeta": {
    "@tauri-apps/api": {
      "optional": true
    }
  }
}
