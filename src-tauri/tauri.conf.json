{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "openagent",
  "version": "0.48.0-beta.2",
  "identifier": "com.iumm.openagent",
  "build": {
    "beforeDevCommand": "bun run prepare:linux-sandbox:dev && bun run prepare:windows-sandbox:dev && bun run dev",
    "beforeBuildCommand": "bun run prepare:linux-sandbox:release && bun run prepare:windows-sandbox:release && bun run build",
    "frontendDist": "../build",
    "removeUnusedCommands": true,
    "additionalWatchFolders": [
      "../sdk/rust"
    ]
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "openagent",
        "width": 800,
        "height": 600,
        "minWidth": 1040,
        "minHeight": 500,
        "decorations": false,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/pasted-attachments/**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/models/all-MiniLM-L6-v2-q/": "models/all-MiniLM-L6-v2-q/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzNzMyODRGQ0Y5NjU2QTAKUldTZ1ZwYlBUeWh6dzQ2SUxMNHZCYmpnNFh1ZUhGeEtoVGs0OERDR3FBVC9JZkU1dlN5QkRTR2wK",
      "endpoints": [
        "https://github.com/BANG404/openagent/releases/download/beta/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
