{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenAgent",
  "version": "0.75.0-beta.1",
  "identifier": "com.iumm.openagent",
  "build": {
    "beforeDevCommand": "bun scripts/prepare-dev-helpers.mjs && bun run dev:tauri",
    "beforeBuildCommand": "bun run build && bun run build:bootstrap",
    "frontendDist": "../.cache/bootstrap-dist",
    "removeUnusedCommands": false,
    "additionalWatchFolders": [
      "runtime-server-watch"
    ]
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "OpenAgent",
        "width": 800,
        "height": 600,
        "minWidth": 1040,
        "minHeight": 500,
        "decorations": false,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/pasted-attachments/**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzNzMyODRGQ0Y5NjU2QTAKUldTZ1ZwYlBUeWh6dzQ2SUxMNHZCYmpnNFh1ZUhGeEtoVGs0OERDR3FBVC9JZkU1dlN5QkRTR2wK",
      "endpoints": [
        "https://github.com/BANG404/openagent/releases/download/beta/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
