[Unit]
Description=OpenAgent explicit support report receiver
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/Document/opentelemetry/support-reports
ExecStart=/usr/bin/python3 %h/Document/opentelemetry/support-reports/server.py
Environment=TOKEN_FILE=%h/Document/opentelemetry/secrets/otlp_bearer_token
Environment=REPORT_DIRECTORY=%h/Document/opentelemetry/support-reports/data
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
UMask=0077
MemoryMax=512M
TasksMax=64

[Install]
WantedBy=default.target
