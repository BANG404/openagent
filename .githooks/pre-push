#!/bin/sh
set -eu

remote_name="${1:-}"
if [ "$remote_name" != "origin" ]; then
  exit 0
fi

sanitized_root="4e90aaa836ca42ba39fb333766e249c0e1d1b6e6"
zero_sha="0000000000000000000000000000000000000000"

verify_backend_absent() {
  commit="$1"
  unexpected="$({
    git ls-tree -r --name-only "$commit" -- \
      src-tauri/src \
      src-tauri/crates/openagent-runtime
  } | grep -Ev '^(src-tauri/src/main\.rs|src-tauri/src/bin/openagent-agent-server\.rs)$' || true)"
  if [ -n "$unexpected" ]; then
    echo "Push blocked: commit $commit contains private backend source in the host repository:" >&2
    echo "$unexpected" >&2
    return 1
  fi

  sdk_entry="$(git ls-tree "$commit" -- sdk)"
  set -- $sdk_entry
  if [ "$#" -ne 4 ] || [ "$1" != "160000" ] || [ "$2" != "commit" ] || [ "$4" != "sdk" ]; then
    echo "Push blocked: commit $commit does not store sdk as a gitlink." >&2
    return 1
  fi
}

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "$zero_sha" ]; then
    continue
  fi

  commit="$(git rev-parse "$local_sha^{commit}" 2>/dev/null || true)"
  if [ -z "$commit" ] || ! git merge-base --is-ancestor "$sanitized_root" "$commit"; then
    echo "Push blocked: $local_ref is not descended from the sanitized OpenAgent root." >&2
    echo "Push historical refs only to the archive remote." >&2
    exit 1
  fi

  verify_backend_absent "$sanitized_root"
  for introduced in $(git rev-list "$commit" --not "$sanitized_root"); do
    verify_backend_absent "$introduced"
  done
done
