#!/bin/sh
set -eu

remote_name="${1:-}"
if [ "$remote_name" != "origin" ]; then
  exit 0
fi

zero_sha="0000000000000000000000000000000000000000"
hook_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
repo_root="$(CDPATH= cd -- "$hook_dir/.." && pwd)"
public_host_sources="$hook_dir/public-host-sources.txt"

if [ ! -f "$public_host_sources" ]; then
  echo "Push blocked: public host source allowlist is missing: $public_host_sources" >&2
  exit 1
fi

verify_backend_absent() {
  commit="$1"
  product_sources="$(git ls-tree -r --name-only "$commit" -- crates | grep '\.rs$' || true)"
  if [ -n "$product_sources" ]; then
    product_allowlist="$(git show "$commit:.githooks/public-product-sources.txt" 2>/dev/null || true)"
    if [ -z "$product_allowlist" ]; then
      echo "Push blocked: public product Rust source allowlist is missing." >&2
      return 1
    fi
    unexpected_product="$(printf '%s\n%s\n' "$product_allowlist" "$product_sources" | sort | uniq -u)"
    if [ -n "$unexpected_product" ]; then
      echo "Push blocked: public product Rust source differs from its reviewed allowlist:" >&2
      echo "$unexpected_product" >&2
      return 1
    fi
  fi
  unexpected="$({
    git ls-tree -r --name-only "$commit" -- \
      src-tauri/src \
      src-tauri/crates/openagent-runtime
  } | grep -Fvx -f "$public_host_sources" || true)"
  if [ -n "$unexpected" ]; then
    echo "Push blocked: commit $commit contains private backend source in the host repository:" >&2
    echo "$unexpected" >&2
    return 1
  fi

  sdk_entry="$(git ls-tree "$commit" -- runtime)"
  if [ -z "$sdk_entry" ]; then
    sdk_entry="$(git ls-tree "$commit" -- sdk)"
  fi
  set -- $sdk_entry
  if [ "$#" -ne 4 ] || [ "$1" != "160000" ] || [ "$2" != "commit" ] || { [ "$4" != "runtime" ] && [ "$4" != "sdk" ]; }; then
    echo "Push blocked: commit $commit does not store the private Runtime as a gitlink." >&2
    return 1
  fi

  (CDPATH= cd -- "$repo_root" && bun scripts/verify-sdk-gitlink.mjs --host-revision "$commit")
}

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "$zero_sha" ]; then
    continue
  fi

  commit="$(git rev-parse "$local_sha^{commit}" 2>/dev/null || true)"
  if [ -z "$commit" ]; then
    echo "Push blocked: $local_ref does not resolve to a commit." >&2
    exit 1
  fi

  if [ "$remote_sha" = "$zero_sha" ]; then
    introduced_commits="$(git rev-list "$commit")"
  else
    introduced_commits="$(git rev-list "$commit" --not "$remote_sha")"
  fi

  for introduced in $introduced_commits; do
    verify_backend_absent "$introduced"
  done
done
