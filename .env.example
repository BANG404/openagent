# Tool-call structured output integration tests
# Uses an OpenAI-compatible chat completions endpoint.
OPENAGENT_TEST_MODEL=your-model
OPENAGENT_TEST_API_KEY=your-api-key
OPENAGENT_TEST_BASE_URL=https://your-provider.example/v1
# OPENAGENT_TEST_PROVIDER=openai

# Langfuse tracing
# Optional. Leave empty or remove these values to disable tracing export.
LANGFUSE_PUBLIC_KEY=pk-...
LANGFUSE_SECRET_KEY=sk-...
LANGFUSE_HOST=https://cloud.langfuse.com

# Privacy-filtered application diagnostics (optional for local builds).
# Release builds receive the write-only ingestion token from GitHub Actions.
OPENAGENT_LOGS_ENDPOINT=https://openagentlogs.odn.cc/v1/logs
OPENAGENT_LOGS_INGEST_TOKEN=
